<project name="simple-java" default="compile">

    <property name="src" value="src"/>
    <property name="build" value="bin"/>
    <property name="lib" value="lib"/>
    <property name="glassfish.home" value="${env.GLASSFISH_HOME}"/>
    <property name="mysql.connector" value="${env.MYSQL_CONNECTOR}"/>

    <path id="classpath">
        <fileset dir="${lib}" includes="*.jar"/>
        <pathelement location="${glassfish.home}/lib/gf-client.jar"/>
        <pathelement location="${mysql.connector}"/>
    </path>

    <target name="compile">
        <mkdir dir="${build}"/>

        <javac destdir="${build}" includeantruntime="false" classpathref="classpath">
            <src path="${src}"/>
        </javac>

        <!-- Copy card images onto the classpath so they can be loaded as resources -->
        <copy todir="${build}/cards">
            <fileset dir="${lib}" includes="*.png"/>
        </copy>
    </target>

    <target name="clean">
        <delete dir="${build}"/>
    </target>

</project>